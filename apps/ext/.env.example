# =============================================================================
# Development
# =============================================================================
NODE_ENV=development
VITE_DEV_MODE=true

# =============================================================================
# Extension Identity
# =============================================================================
VITE_EXTENSION_ID=your-extension-id
VITE_EXTENSION_NAME="React Perf Profiler"

# =============================================================================
# Debug — set to 'true' for verbose logging
# =============================================================================
DEBUG_PROFILER=false
DEBUG_BRIDGE=false

# =============================================================================
# Feature Flags
# =============================================================================
VITE_ENABLE_TIMELINE=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_CLOUD_SYNC=false

# =============================================================================
# AI Provider — ollama | openai | claude
# =============================================================================
# VITE_AI_PROVIDER=ollama
# VITE_AI_MODEL=gpt-4
# VITE_AI_BASE_URL=http://localhost:11434

# =============================================================================
# Sentry crash reporting — set DSN to enable, omit to disable
# =============================================================================
# VITE_SENTRY_DSN="https://your-key@o0.ingest.sentry.io/0"

# =============================================================================
# Team collaboration relay — WebSocket signaling URL for auto-mode sessions
# =============================================================================
# VITE_COLLAB_RELAY_URL="wss://your-relay.example.com"

# =============================================================================
# Cloud Sync
# =============================================================================
VITE_CLOUD_SYNC_ENABLED=false
VITE_CLOUD_PROVIDER=local
# Supported providers: local, s3, gcs, dropbox, onedrive

# S3-Compatible Storage
# VITE_S3_ENDPOINT=https://s3.amazonaws.com
# VITE_S3_BUCKET=react-perf-profiles
# VITE_S3_REGION=us-east-1
# VITE_S3_ACCESS_KEY_ID=your-access-key
# VITE_S3_SECRET_ACCESS_KEY=your-secret-key

# Google Cloud Storage
# VITE_GCS_BUCKET=react-perf-profiles
# VITE_GCS_PROJECT_ID=your-project-id

# Dropbox
# VITE_DROPBOX_APP_KEY=your-dropbox-app-key
# VITE_DROPBOX_FOLDER=/React Perf Profiles

# OneDrive
# VITE_ONEDRIVE_CLIENT_ID=your-onedrive-client-id
# VITE_ONEDRIVE_FOLDER=/React Perf Profiles

# Google Drive (omit to disable)
# VITE_DISABLE_GOOGLE_DRIVE_SYNC=true

# =============================================================================
# Export
# =============================================================================
VITE_EXPORT_COMPRESSION_THRESHOLD=1048576
VITE_EXPORT_MAX_SIZE=104857600
VITE_ENABLE_EXPORT_SCREENSHOT=false

# =============================================================================
# Build metadata
# =============================================================================
# VITE_GITHUB_REPO_URL="https://github.com/rejisterjack/react-perf-profiler"
# VITE_ISSUE_REPORT_URL="https://github.com/rejisterjack/react-perf-profiler/issues/new"
# VITE_APP_VERSION="1.0.0"
