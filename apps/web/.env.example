# =============================================================================
# React Perf Profiler — Web App (apps/web) environment variables
# =============================================================================
# Copy this file to `.env` (and `.env.local` for local overrides) and fill in
# the values. NEVER commit real secrets. `.gitignore` already excludes .env*.
#
# All variables below are read at build time and baked into the build (Next.js
# requirement) — changing them requires a redeploy.
# =============================================================================

# ---- Database (REQUIRED) -----------------------------------------------------
# Connection string used by Prisma Client at runtime. Use the **pooled** URL
# (e.g. pgbouncer / PgBouncer-on-Vercel / Neon pooler) in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&connection_limit=1"

# Direct (non-pooled) connection used by Prisma Migrate / `prisma db push`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# ---- Auth (REQUIRED) --------------------------------------------------------
# NextAuth / JWT signing secret. Generate with:
#   openssl rand -base64 32
# Do NOT use 'dev-secret-change-me', 'change-me', or any placeholder — the app
# refuses to boot with a known-weak secret (see src/lib/auth.ts).
NEXTAUTH_SECRET=""

# Comma-separated list of allowed Chrome/Firefox extension IDs that may call
# the API with a Bearer token. Leave unset in development to allow any
# extension ID. After publishing to the Chrome Web Store, set this to the
# assigned extension ID (e.g. "abcdefghijklmnopqrstuvwxyz").
# Example: ALLOWED_EXTENSION_IDS="abcdefghijklmnopqrstuvwx"
ALLOWED_EXTENSION_IDS=""

# ---- Public site config (REQUIRED in production) ----------------------------
# Canonical site URL. Used for SEO metadata, sitemap, robots, OpenGraph.
NEXT_PUBLIC_SITE_URL="http://localhost:7394"

# ---- Analytics (optional) ---------------------------------------------------
# Plausible analytics domain. When unset, the Plausible script is NOT loaded
# (see src/app/layout.tsx) — preventing requests to localhost in dev.
# Example: NEXT_PUBLIC_PLAUSIBLE_DOMAIN="reactperfprofiler.com"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ---- Email capture (optional) ----------------------------------------------
# Formspree form ID or custom endpoint for the EmailCapture component.
NEXT_PUBLIC_FORMSPREE_ID=""
NEXT_PUBLIC_EMAIL_ENDPOINT=""
